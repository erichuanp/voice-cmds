{
  "hotkey": {
    "start": "left ctrl+right alt",
    "stop": "right alt",
    "cancel": "esc"
  },
  "stop_mode": "vad",
  "vad_silence_ms": 500,
  "max_chars": 15,
  "shutdown_delay_seconds": 15,
  "ui": {
    "color_idle": "#00C853",
    "color_error": "#E53935",
    "bottom_offset_px": 8,
    "max_capsule_width_px": 240,
    "circle_diameter_px": 26,
    "shadow_margin_px": 8,
    "font_size_pt": 7
  },
  "match": {
    "embedding_similarity_threshold": 0.67,
    "pinyin_similarity_threshold": 0.88
  },
  "sound": {
    "success_enabled": true,
    "error_enabled": true
  }
}